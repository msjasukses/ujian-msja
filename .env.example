APP_NAME="Aplikasi Ujian Sekolah"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://ujian.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database utama aplikasi ujian
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ujian
DB_USERNAME=root
DB_PASSWORD=

# Koneksi ke database Data Center (READ-ONLY) — sumber data siswa, guru,
# wali kelas, guru mapel, mata pelajaran, tingkat kelas & tahun ajaran.
DATACENTER_DB_CONNECTION=mysql
DATACENTER_DB_HOST=127.0.0.1
DATACENTER_DB_PORT=3306
DATACENTER_DB_DATABASE=datacenter_v2
DATACENTER_DB_USERNAME=root
DATACENTER_DB_PASSWORD=

# Koneksi ke database Kurikulum (READ-ONLY) — sumber Sinkron CP-TP-ATP.
KURIKULUM_DB_CONNECTION=mysql
KURIKULUM_DB_HOST=127.0.0.1
KURIKULUM_DB_PORT=3306
KURIKULUM_DB_DATABASE=kurikulum
KURIKULUM_DB_USERNAME=root
KURIKULUM_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="ujian@sekolah.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
